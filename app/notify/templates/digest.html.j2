{#
  The digest email. Email clients ignore most CSS files and many modern rules,
  so styles are written inline and the layout stays a simple stack of blocks.
#}
<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
    <div style="max-width:640px;margin:0 auto;padding:24px 16px;">

      <h1 style="margin:0 0 4px;font-size:20px;">{{ title }}</h1>
      <p style="margin:0 0 24px;color:#71717a;font-size:13px;">
        {{ video_count }} new video{{ '' if video_count == 1 else 's' }}
        from {{ channel_count }} channel{{ '' if channel_count == 1 else 's' }}
        &middot; {{ generated_at }}
      </p>

      {% for group in groups %}
        <div style="background:#ffffff;border:1px solid #e4e4e7;border-radius:8px;padding:16px;margin-bottom:16px;">
          <h2 style="margin:0 0 12px;font-size:15px;">
            <a href="{{ group.channel.url }}" style="color:#18181b;text-decoration:none;">{{ group.channel.title }}</a>
            {% if group.channel.tags %}
              <span style="color:#a1a1aa;font-weight:normal;font-size:12px;">{{ group.channel.tags | join(', ') }}</span>
            {% endif %}
          </h2>

          {% for video in group.videos %}
            <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin-bottom:14px;">
              <tr>
                {% if video.thumbnail_url %}
                  <td style="width:120px;vertical-align:top;padding-right:12px;">
                    <a href="{{ video.url }}">
                      <img src="{{ video.thumbnail_url }}" width="120" alt=""
                           style="display:block;border-radius:4px;border:0;">
                    </a>
                  </td>
                {% endif %}
                <td style="vertical-align:top;">
                  <a href="{{ video.url }}" style="color:#2563eb;text-decoration:none;font-size:14px;font-weight:600;">
                    {{ video.title }}
                  </a>
                  <div style="color:#71717a;font-size:12px;margin-top:4px;">
                    {{ video.published_local }}
                    {% if video.views is not none %} &middot; {{ '{:,}'.format(video.views) }} views{% endif %}
                  </div>
                  {% if video.summary %}
                    <div style="font-size:13px;color:#3f3f46;margin-top:6px;">{{ video.summary }}</div>
                  {% endif %}
                </td>
              </tr>
            </table>
          {% endfor %}
        </div>
      {% endfor %}

      <p style="color:#a1a1aa;font-size:11px;margin-top:24px;">
        Sent by your local AI News Aggregator. Edit channels.toml to change what you follow.
      </p>
    </div>
  </body>
</html>
